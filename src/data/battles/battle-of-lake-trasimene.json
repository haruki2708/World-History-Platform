            },
            {
              "title": "L. Borgia et al., First results of waterborne geophysical surveys around the Malpasso site (Tuoro sul Trasimeno, Italy), GNGTS 2013, pp. 186–188",
              "url": "https://gngts.ogs.it/atti/GNGTS2013/1049/"
            }
          ]
        },
