# Copy to .env.local (never committed) and fill in.

# Claude API key for the AI tutor. Server-side only; never expose it to the
# browser (no NEXT_PUBLIC_ prefix). Create one at https://platform.claude.com
ANTHROPIC_API_KEY=

# 1 = the tutor streams canned answers built from the request and never calls
# the API. Use it for development and tests; it costs nothing.
TUTOR_MOCK=1
