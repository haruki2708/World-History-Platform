# Copy to .env.local (never committed) and fill in.

# Claude API key for the AI tutor. Server-side only; never expose it to the
# browser (no NEXT_PUBLIC_ prefix). Create one at https://platform.claude.com
ANTHROPIC_API_KEY=

# 1 = the tutor streams canned answers built from the request and never calls
# the API. Use it for development and tests; it costs nothing.
TUTOR_MOCK=1

# Usage limits of the tutor. Leave empty for the defaults shown; a value that
# is not a positive number is ignored (with a warning in the server log).
# Questions per person (IP address) in any 60 seconds; above it: rate_limited.
TUTOR_QUESTIONS_PER_MINUTE=6
# Questions per person per UTC day; above it: limit_reached until midnight UTC.
TUTOR_QUESTIONS_PER_DAY=100
# Spending cap of the whole app per UTC day, in USD, estimated from the token
# usage of each answer. Once reached, every question gets limit_reached until
# midnight UTC. Counters live in server memory and reset on restart.
TUTOR_DAILY_BUDGET_USD=5
